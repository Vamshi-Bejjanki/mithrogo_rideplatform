# ---------------------------------------------------------------------------
# Sample configuration for the MithrGo backend.
#
# How to use:
#   1. Copy this file to backend/.env   (do NOT edit this file with real values)
#   2. Replace every value marked CHANGE-ME with your own
#   3. Never commit .env to git. Only this sample file is committed.
#
# Note: the app does not read .env automatically yet. Load it into your shell
# (or add a loader such as python-dotenv) before running manage.py.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate a new key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-long-random-key
# 1 = development (DEBUG on). 0 = production. Must be 0 in production.
DJANGO_DEBUG=1
# Comma-separated hosts the server answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated HTTPS origins that may submit forms, e.g. https://admin.example.com
# Leave empty for local development.
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL ------------------------------------------------------------
# Created with the CREATE USER / CREATE DATABASE commands on your Postgres server.
# Leave POSTGRES_DB empty to use a local SQLite file instead (quick tests only).
POSTGRES_DB=mithrgo_app
POSTGRES_USER=mithrgo_app
POSTGRES_PASSWORD=CHANGE-ME-your-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- OTP / login -------------------------------------------------------------
# Real SMS through MSG91 (DLT-approved OTP template). Keys come from the MSG91 dashboard.
SMS_PROVIDER=apps.users.sms.Msg91SmsProvider
MSG91_AUTH_KEY=REPLACE-WITH-MSG91-AUTHKEY
MSG91_TEMPLATE_ID=REPLACE-WITH-DLT-TEMPLATE-ID

# --- Payments (mock until a real gateway is integrated) --------------------
PAYMENT_PROVIDER=apps.payments.providers.MockPaymentProvider
# Shared secret used to sign payment webhooks. Use a long random value.
PAYMENT_WEBHOOK_SECRET=CHANGE-ME-webhook-secret

# --- Logging ---------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
