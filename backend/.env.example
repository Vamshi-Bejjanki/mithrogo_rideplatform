# Copy to backend/.env (never commit the real file). Load it with your process manager or docker-compose env_file.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL (leave POSTGRES_DB empty to use SQLite for quick local runs)
POSTGRES_DB=ridemvp
POSTGRES_USER=ridemvp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# OTP: development only. Returns the code in the API response so you can test without SMS.
OTP_RETURN_CODE_FOR_DEV=1
SMS_PROVIDER=apps.users.sms.ConsoleSmsProvider

# Payments: mock provider with HMAC-signed webhooks until the real gateway is integrated
PAYMENT_PROVIDER=apps.payments.providers.MockPaymentProvider
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

LOG_LEVEL=INFO
